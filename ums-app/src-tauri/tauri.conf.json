{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ums-app",
  "version": "0.1.0",
  "identifier": "com.petro-malamule.ums-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ums-app",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Shaunpetro/ums/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyMkYzRkQ3RTQxM0NEQTgKUldTb3pSUGsxejh2NG80ZkxGcjZmVTUrRCtFYTAxK29rOG44MTgvM0lCK0piRWxSZE4ydFdtWHgK",
      "dialog": true
    }
  }
}